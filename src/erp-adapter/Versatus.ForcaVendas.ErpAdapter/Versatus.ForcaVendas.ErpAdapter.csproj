<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-Versatus.ForcaVendas.ErpAdapter-d6d48cf1-20f1-4fdf-b00f-5515123f25d4</UserSecretsId>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\backend\Versatus.ForcaVendas.Infrastructure\Versatus.ForcaVendas.Infrastructure.csproj" />
  </ItemGroup>

  <Target Name="PopulateVersionInfo" BeforeTargets="BeforeBuild">
    <Exec Command="git describe --tags --always" ConsoleToMSBuild="true" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitVersion" />
    </Exec>
    <Exec Command="git rev-parse --abbrev-ref HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitBranch" />
    </Exec>
    <PropertyGroup>
      <ActualVersion>1.0.0-unknown</ActualVersion>
      <ActualVersion Condition="'$(GitVersion)' != '' and !$(GitVersion.StartsWith('fatal'))">$(GitVersion.Trim())</ActualVersion>
      <GitBranchClean>production</GitBranchClean>
      <GitBranchClean Condition="'$(GitBranch)' != '' and !$(GitBranch.StartsWith('fatal'))">$(GitBranch.Trim())</GitBranchClean>
      <InformationalVersion>$(ActualVersion)+$(GitBranchClean) (Build: $([System.DateTime]::UtcNow.ToString("yyyy-MM-dd HH:mm:ss")) UTC)</InformationalVersion>
    </PropertyGroup>
  </Target>

</Project>
